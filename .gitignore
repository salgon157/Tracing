# --- OSOBNI UDAJE ZAKAZNIKU / RIDICU (GDPR) — NIKDY do gitu! ---
# RiRo vstupy a pripravene objednavky = jmena, adresy, GPS, vahy zakazniku.
# locations_*.csv = nazvy + adresy + GPS zakazniku.
# vehicle_registry.csv = jmena ridicu + SPZ.
# data/ridici/ = registr aut+ridicu z ESO (jmena, telefony, SPZ).
# Verzuji se jen config bez PII: vehicle_types.csv a closures.json.
data/input/
data/prepared/
data/static/locations_*.csv
data/static/vehicle_registry.csv
data/ridici/

# --- Predikcni behy (cely strom: input/prepared/results) ---
# Predikovane objednavky = realne radky zakazniku (PII) + generovane vystupy.
data/prediction/

# --- Historie objednavek (rocni exporty pro vypocet sance zavozu) ---
# Kdo, kdy a kam se vozilo, vcetne GPS a kilogramu — cistokrevne PII.
data/historie_objednavky/

# --- Routovaci data (ORS/OSRM grafy, stahovana / v Docker volume) ---
routing/

# --- Lokalni nastaveni editoru / Claude ---
.claude/settings.local.json
.vscode/

# --- webui runtime joby (job.json + job.log per beh) ---
webui/jobs/

# --- vystupy experimentu (generovane, muzou obsahovat PII z objednavek) ---
experiments/*/results/

# ARCHIV — NESAHAT: git worktree se starým solverem (strana A regresního
# A/B, viz regression_ab.py a WORKFLOW 8). Není součást projektu, needituje
# se, nespouští se odsud ostrý běh. Popis: _baseline_*/_NESAHAT_ARCHIV.md
/_baseline_*/
